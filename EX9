//knapsack BRANCH BOUND
import java.util.*;

class Item {
    float weight;
    int value;
    int id;

    Item(int value, float weight, int id) {
        this.value = value;
        this.weight = weight;
        this.id = id;
    }
}

class Node {
    int level;      // Level of node in decision tree
    int profit;     // Cumulative profit
    float weight;   // Cumulative weight
    float bound;    // Upper bound of profit in subtree

    Node() {}
    
    Node(Node temp) {
        this.level = temp.level;
        this.profit = temp.profit;
        this.weight = temp.weight;
        this.bound = temp.bound;
    }
}

public class KnapsackBranchBound {

    // Comparison function to sort items according to value/weight ratio
    private static int compareItems(Item a, Item b) {
        double r1 = (double) a.value / a.weight;
        double r2 = (double) b.value / b.weight;
        return Double.compare(r2, r1);
    }

    // Best-First Search Upper Bound calculation
    private static float bound(Node u, int n, int W, Item[] items) {
        if (u.weight >= W) return 0;

        float profitBound = u.profit;
        int j = u.level + 1;
        float totalWeight = u.weight;

        while (j < n && totalWeight + items[j].weight <= W) {
            totalWeight += items[j].weight;
            profitBound += items[j].value;
            j++;
        }

        // If capacity is left, add fractional part of next item
        if (j < n) {
            profitBound += (W - totalWeight) * items[j].value / items[j].weight;
        }

        return profitBound;
    }

    public static int solveKnapsack(int W, Item[] items, int n) {
        // Sort items by ratio
        Arrays.sort(items, KnapsackBranchBound::compareItems);

        PriorityQueue<Node> Q = new PriorityQueue<>((a, b) -> Float.compare(b.bound, a.bound));
        
        Node u = new Node();
        Node v = new Node();

        u.level = -1;
        u.profit = 0;
        u.weight = 0;
        u.bound = bound(u, n, W, items);
        Q.add(u);

        int maxProfit = 0;

        while (!Q.isEmpty()) {
            u = Q.poll();

            if (u.level == n - 1) continue;

            // Move to next item
            v.level = u.level + 1;

            // Case 1: Include current item
            v.weight = u.weight + items[v.level].weight;
            v.profit = u.profit + items[v.level].value;

            if (v.weight <= W && v.profit > maxProfit) {
                maxProfit = v.profit;
            }

            v.bound = bound(v, n, W, items);
            if (v.bound > maxProfit) {
                Q.add(new Node(v));
            }

            // Case 2: Exclude current item
            v.weight = u.weight;
            v.profit = u.profit;
            v.bound = bound(v, n, W, items);

            if (v.bound > maxProfit) {
                Q.add(new Node(v));
            }
        }

        return maxProfit;
    }

    public static void main(String[] args) {
        int W = 10;
        Item[] items = {
            new Item(40, 2, 1),
            new Item(42, 3, 2),
            new Item(25, 5, 3),
            new Item(12, 2, 4)
        };

        System.out.println("Maximum Profit: " + solveKnapsack(W, items, items.length));
    }
}
